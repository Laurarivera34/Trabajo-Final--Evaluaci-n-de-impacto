base_matching_m3 <- base_lags %>%
filter(ano == 2016 & pdet == 1) %>%
select(codmpio, vocacion_turistica, l_log_pobl_tot, l_indrural,
l_tasa_urbanizacion, l_tasa_sisben, l_tasa_homicidios,
l_tasa_extorsion, l_df_ing_propios, l_valor_agregado_pc, l_s11_lectu) %>%
na.omit()
match_out_m3 <- matchit(
formula = vocacion_turistica ~ l_log_pobl_tot + l_indrural + l_tasa_urbanizacion +
l_tasa_sisben + l_tasa_homicidios + l_tasa_extorsion +
l_df_ing_propios + l_valor_agregado_pc + l_s11_lectu,
data = base_matching_m3,
method = "nearest",
distance = "logit",
ratio = 1,
replace = FALSE
)
print(summary(match_out_m3))
print(bal_m3)
love.plot(bal_m3, threshold = .1, main = "Love plot: M3 (PDET tur vs PDET no tur)")
bal_m3 <- bal.tab(match_out_m3, un = TRUE)
print(bal_m3)
love.plot(bal_m3, threshold = .1, main = "Love plot: M3 (PDET tur vs PDET no tur)")
datos_matched_m3 <- match.data(match_out_m3) %>%
dplyr::select(codmpio, weights) %>%
distinct(codmpio, .keep_all = TRUE)
base_panel_psm_m3 <- base_lags %>%
filter(codmpio %in% datos_matched_m3$codmpio) %>%
left_join(datos_matched_m3, by = "codmpio")
stopifnot(sum(is.na(base_panel_psm_m3$weights)) == 0)
modelo_3_psm <- felm(
log1p(visitantes_extranjeros_no_residentes) ~
pdet_tur_dummy * post +
l_log_pobl_tot + l_indrural + l_tasa_urbanizacion + l_tasa_sisben +
l_tasa_homicidios + l_tasa_extorsion + l_tasa_ataq_instpol +
l_df_ing_propios + l_df_gast_inv + l_df_desemp_fisc +
l_valor_agregado_pc + l_participacion_terciarias +
l_tasa_docentes + l_tasa_alumnos_med + l_s11_ingles + l_log_t_establ + l_s11_lectu
| codmpio + ano | 0 | cod_dpto,
data = base_panel_psm_m3,
weights = base_panel_psm_m3$weights
)
modelos_sin_psm <- list(
"M1 (DiD)" = modelo_1_nopsm,
"M2 (DiD)" = modelo_2_nopsm,
"M3 (DiD)" = modelo_3_nopsm
)
tabla_modelos_sinpsm <- stargazer(
modelos_sin_psm,
title = "Tabla 1: Resultados DiD sin PSM (Efectos Fijos)",
type = "text",
dep.var.labels = "log(1 + Visitantes Extranjeros)",
model.numbers = FALSE,
column.labels = c("Modelo 1", "Modelo 2", "Modelo 3"),
# --- ETIQUETAS DE COEFICIENTES Y ORDEN ---
covariate.labels = c(
# 1. INTERACCIONES (Efecto DiD)
"PDET × Post (M1)",
"Tratado Turístico × Post (M2, M3)",
# 2. VARIABLES BASE
"PDET (M1)",
"Tratado Turístico (M2, M3)",
"Post 2017",
# 3. CONTROLES LAGGED
"Lag log población total", "Lag índice ruralidad", "Lag tasa urbanización",
"Lag tasa SISBEN", "Lag tasa homicidios", "Lag tasa extorsión", "Lag tasa ataques inst.",
"Lag ingresos propios", "Lag gasto inversión", "Lag desempeño fiscal",
"Lag valor agregado pc", "Lag participación terc.",
"Lag tasa docentes", "Lag tasa alumnos media", "Lag Saber 11 inglés",
"Lag log establecimientos", "Lag Saber 11 lectura"
),
# --- VARIABLES A INCLUIR (keep) ---
keep = c(
# Interacciones
"pdet:post", "tratado_tur:post",
# Variables Base
"pdet", "tratado_tur", "post",
# Controles Lagged (Misma lista que antes)
"l_log_pobl_tot", "l_indrural", "l_tasa_urbanizacion", "l_tasa_sisben",
"l_tasa_homicidios", "l_tasa_extorsion", "l_tasa_ataq_instpol",
"l_df_ing_propios", "l_df_gast_inv", "l_df_desemp_fisc",
"l_valor_agregado_pc", "l_participacion_terciarias",
"l_tasa_docentes", "l_tasa_alumnos_med", "l_s11_ingles",
"l_log_t_establ", "l_s11_lectu"
),
# --- ESTADÍSTICAS Y NOTAS FINALES ---
omit.stat = c("f", "ser", "rsq"),
add.lines = list(
c("Efectos Fijos (Mpio & Año)", rep("Sí", 3)),
c("Errores Estándar", rep("Clusterizados (Dpto)", 3))
),
no.space = TRUE
)
