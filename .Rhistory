#Modelo 3: Diferencias en Diferencias municipios pdet turistico vs pdet no turistico
muestra_modelo3 <- base_lags %>%
mutate(
tratado_tur = if_else(pdet == 1 & vocacion_turistica == 1, 1L, 0L)
)
muestra_modelo3 <- base_lags %>%
filter(pdet == 1)
modelo_3 <- felm(
log1p(visitantes_extranjeros_no_residentes) ~
tratado_tur * post +
l_log_pobl_tot +
l_log_homicidios +
l_log_extorsion +
l_df_ing_propios +
l_df_gast_inv +
l_df_desemp_fisc +
l_log_valor_agregado +
l_actividades_terciarias +
l_participacion_terciarias +
l_tasa_sisben +
l_docen_total +
l_t_establ +
l_alumn_med +
l_s11_ingles +
l_s11_lectu
| codmpio + ano
| 0
| cod_dpto,
data = muestra_modelo3
)
stargazer(
modelo_3,
title = "DiD: PDET con vocación turística vs PDET sin vocación turística",
type  = "text",
dep.var.labels = "log(1 + visitantes extranjeros no residentes)",
keep = c(
"treat_pdet_tur", "post", "treat_pdet_tur:post",
"l_log_pobl_tot", "l_log_homicidios", "l_log_extorsion",
"l_df_ing_propios", "l_df_gast_inv", "l_df_desemp_fisc",
"l_log_valor_agregado", "l_actividades_terciarias",
"l_participacion_terciarias", "l_tasa_sisben",
"l_docen_total", "l_t_establ", "l_alumn_med",
"l_s11_ingles", "l_s11_lectu"
),
omit.stat = c("f", "ser", "rsq"),
no.space = TRUE
)
#Propensity Score y tendencias paralelas
base_psm <- base_completa %>%
filter(ano == 2016)
datos_emparejados <- datos_emparejados %>%
mutate(
ano = as.numeric(as.character(ano)),  # asegurar que sea numérica
event_time = ano - 2017
)
# Ejecutar el PSM por región con transformaciones y método "optimal"
m_caliper <- matchit(
formula = pdet ~ log1p(poblacion) + log1p(homicidios) + log1p(t_establ_o) +
indrural + df_desemp_fisc + discapital + act_primarias +
act_secundarias + act_terciarias,
data = base_completa,
method = "nearest",     # emparejamiento por vecino más cercano
distance = "logit",     # estima el propensity score mediante regresión logística
caliper = 0.15,          # límite máximo permitido de diferencia en el propensity score
replace = FALSE
)
