#Extraer los coeficientes
get_safe <- function(obj, name) {
x <- tryCatch(obj[name], error = function(e) NA_real_)
if (length(x) == 0) NA_real_ else x
}
# M1 (Base)
coef_real   <- get_safe(coef(modelo_did_psm_control), "pdet:post_real")
se_real     <- get_safe(se(modelo_did_psm_control),   "pdet:post_real")
pval_real   <- get_safe(pvalue(modelo_did_psm_control),"pdet:post_real")
# M2 (Placebo)
coef_placebo <- get_safe(coef(modelo_placebo),       "pdet:post_placebo")
#Ajustar los textos
fmt_coef <- function(coef, se) {
if (is.na(coef) | is.na(se)) {
"NA"
} else {
paste0(round(coef, 3), " (", round(se, 3), ")")
}
}
att_text      <- fmt_coef(coef_real,    se_real)
placebo_text  <- fmt_coef(coef_placebo, se_placebo)
# M2 (Placebo)
coef_placebo <- get_safe(coef(modelo_placebo),       "pdet:post_placebo")
#Ajustar los textos
fmt_coef <- function(coef, se) {
if (is.na(coef) | is.na(se)) {
"NA"
} else {
paste0(round(coef, 3), " (", round(se, 3), ")")
}
}
att_text      <- fmt_coef(coef_real,    se_real)
placebo_text  <- fmt_coef(coef_placebo, se_placebo)
se_placebo   <- get_safe(se(modelo_placebo),         "pdet:post_placebo")
placebo_text  <- fmt_coef(coef_placebo, se_placebo)
# 2. Generar tabla con Stargazer (Omitiendo la mayoría de los coeficientes)
stargazer(
modelo_did_psm_control,
modelo_placebo,
title = "Prueba de Placebo: Falsificación del Inicio del Tratamiento",
type  = "html",
out   = "Graficos-tablas/prueba_placebo_final.html",
# Mejor usar patrones más precisos en keep:
keep = c("pdet:post_real", "pdet:post_placebo",
"pdet$", "post_real", "post_placebo",
"poblacion", "homicidios", "t_establ_o",
"df_desemp_fisc", "act_primarias", "act_secundarias", "act_terciarias"),
omit.stat = c("f", "ser", "rsq"),
add.lines = list(
c("ATT (pdet × post_real)",            att_text,     "NA"),
c("Placebo (pdet × post_placebo)",     "NA",         placebo_text),
c("Efectos Fijos de Municipio",        "Sí",         "Sí"),
c("Efectos Fijos de Año",              "Sí",         "Sí"),
c("Errores agrupados por región",      "Sí",         "Sí")
),
column.labels = c("Modelo base", "Modelo placebo"),
header   = FALSE,
no.space = TRUE
)
# 2. Generar tabla con Stargazer (Omitiendo la mayoría de los coeficientes)
stargazer(
modelo_did_psm_control,
modelo_placebo,
title = "Prueba de Placebo: Falsificación del Inicio del Tratamiento",
type = "html",
out = "Graficos-tablas/prueba_placebo_final_ajustada.html",
# 1. Definir los coeficientes que SIEMPRE deben imprimirse (los comunes)
keep = c("pdet", "post_real", "log1p(poblacion)", "log1p(homicidios)", "t_establ_o",
"df_desemp_fisc", "act_primarias", "act_secundarias", "act_terciarias"),
# 2. Omitir el resto, incluyendo el término de interacción que falla al alinearse.
omit = c("pdet:post_real", "pdet:post_placebo", "post_placebo"),
omit.stat = c("f", "ser", "rsq"),
# 3. Insertar la interacción crítica con add.lines:
add.lines = list(
c("", "", ""), # Línea en blanco
c("\\hline Interacción Clave (ATT)", "", ""),
c("pdet $\\times$ post\_real (Base)",
