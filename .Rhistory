Max = ~max(.x, na.rm = TRUE),
Promedio = ~mean(.x, na.rm = TRUE)
),
.names = "{.col}_{.fn}" # agrega sufijo a los nombres de columnas
))
# crear tabla
tabla_html <- tabla_estadisticas %>%
