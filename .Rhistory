# Se escoge el año de programa
datos_emparejados <- datos_emparejados %>%
mutate(
post = as.numeric(ano >= 2017) # 1 si el año es 2017 o posterior, 0 si es anterior
)
# Modelo sin controles
modelo_did_psm <- felm(
log1p(visitantes_extranjeros_no_residentes) ~ pdet * post
| codmpio + ano
| 0
| region,
data = datos_emparejados
)
# Modelo 2 con controles
modelo_did_psm_control <- felm(
log1p(visitantes_extranjeros_no_residentes) ~ pdet * post +
log1p(poblacion) +
log1p(homicidios) +
log1p(t_establ_o) +
df_desemp_fisc +
act_primarias +
act_secundarias +
act_terciarias
| codmpio + ano
| 0
| region,
data = datos_emparejados
)
stargazer(
modelo_did_psm,
modelo_did_psm_control,
title = "Impacto del PDET (DiD con PSM): Comparación de Modelos",
out = "Graficos-tablas/modelo_did_psm_comparativa.html",
type = "html",
# Ajuste de etiquetas
covariate.labels = c(
"Tratamiento (PDET)",
"Post-Tratamiento (Post 2017)",
"PDET $\\times$ Post (ATT)",
"Población (Log)",
"Homicidios (Log)",
"Establecimientos (Log)",
"Desempeño Fiscal",
"Act. Primarias",
"Act. Secundarias",
"Act. Terciarias"
),
dep.var.labels = "Log(1+Visitantes Extranjeros)",
# Añadir filas para las estadísticas y los Efectos Fijos
add.lines = list(
c("Efectos Fijos de Municipio", "Sí", "Sí"),
c("Efectos Fijos de Año", "Sí", "Sí"),
c("Errores Estándar Agrupados", "Región", "Región")
),
# Etiquetas de columnas
column.labels = c("Sin Controles", "Con Controles")
)
# Prueba placebo
datos_emparejados <- datos_emparejados %>%
mutate(
# Variable post real (para el modelo base)
post_real = as.numeric(ano >= 2017),
# Variable post placebo (asume que el tratamiento inició en 2015)
post_placebo = as.numeric(ano >= 2015)
)
#Se corre el modelo con el post placebo
modelo_placebo <- felm(
log1p(visitantes_extranjeros_no_residentes) ~ pdet * post_placebo +
# Incluir las mismas covariables que varian en el tiempo:
log1p(poblacion) + log1p(homicidios) + log1p(t_establ_o) +
df_desemp_fisc + act_primarias + act_secundarias + act_terciarias
| codmpio + ano # Efectos Fijos
| 0
| region, # Errores Agrupados
data = datos_emparejados
)
# 1. Extraer los coeficientes de las interacciones clave
coef_real <- coef(modelo_did_psm_control)["pdet:post"]
# Extraer el coeficiente de placebo (La interacción clave en el modelo placebo)
coef_placebo <- coef(modelo_placebo)["pdet:post_placebo"]
# 2. Generar tabla con Stargazer (Omitiendo la mayoría de los coeficientes)
stargazer(
modelo_did_psm_control,
modelo_placebo,
title = "Prueba de Placebo: Falsificación del Inicio del Tratamiento",
type = "html",
out = "Graficos-tablas/prueba_placebo_final.html", # <--- Asegura la ruta y el nombre
# Usar las mismas opciones de keep y omit.stat
keep = c("pdet", "post", "poblacion", "homicidios", "t_establ_o",
"df_desemp_fisc", "act_primarias", "act_secundarias", "act_terciarias",
"post_placebo"),
omit.stat = c("f", "ser", "rsq"),
add.lines = list(
c("Efecto ATT (pdet:post_real)", "Coeficiente en M1", "No Aplica"),
c("Efecto Placebo (pdet:post_placebo)", "No Aplica", "Coeficiente en M2"),
c("Efectos Fijos de Municipio", "Sí", "Sí"),
c("Efectos Fijos de Año", "Sí", "Sí")
),
column.labels = c("Modelo Base", "Modelo Placebo"),
header = FALSE,
no.space = TRUE
)
#Se corre el modelo con el post placebo
modelo_placebo <- felm(
log1p(visitantes_extranjeros_no_residentes) ~ pdet * post_placebo +
# Incluir las mismas covariables que varian en el tiempo:
log1p(poblacion) + log1p(homicidios) + log1p(t_establ_o) +
df_desemp_fisc + act_primarias + act_secundarias + act_terciarias
| codmpio + ano # Efectos Fijos
| 0
| region, # Errores Agrupados
data = datos_emparejados
)
# M1 (Base)
coef_real <- coef(modelo_did_psm_control)["pdet:post_real"]
# M2 (Placebo)
coef_placebo <- coef(modelo_placebo)["pdet:post_placebo"]
# 2. Generar tabla con Stargazer (Omitiendo la mayoría de los coeficientes)
stargazer(
modelo_did_psm_control,
modelo_placebo,
title = "Prueba de Placebo: Falsificación del Inicio del Tratamiento",
type = "html",
out = "Graficos-tablas/prueba_placebo_final_sin_estrellas.html",
omit = ".*",
omit.stat = c("f", "ser", "rsq"),
# Insertar el ATT real y el Placebo de forma manual sin estrellas
add.lines = list(
# Fila del Coeficiente ATT (Efecto real)
c("ATT (Efecto Real 2017)",
sprintf("%.4f", coef_real), # Muestra el coeficiente con 4 decimales
sprintf("%.4f", coef_placebo)
),
# Fila del Error Estándar (SE)
c("Error Estándar",
sprintf("(%.4f)", se_real), # Muestra el SE entre paréntesis
sprintf("(%.4f)", se_placebo)
),
# Líneas de control y efectos fijos
c("", "", ""), # Línea en blanco
c("Interacción Usada", "pdet $\\times$ post\_real", "pdet $\\times$ post\_placebo"),
# 2. Generar tabla con Stargazer (Omitiendo la mayoría de los coeficientes)
stargazer(
modelo_did_psm_control,
modelo_placebo,
title = "Prueba de Placebo: Falsificación del Inicio del Tratamiento",
type = "html",
out = "Graficos-tablas/prueba_placebo_final_sin_estrellas.html",
omit = ".*",
omit.stat = c("f", "ser", "rsq"),
# Insertar el ATT real y el Placebo de forma manual sin estrellas
add.lines = list(
# Fila del Coeficiente ATT (Efecto real)
c("ATT (Efecto Real 2017)",
sprintf("%.4f", coef_real),
sprintf("%.4f", coef_placebo)
),
# Fila del Error Estándar (SE)
c("Error Estándar",
sprintf("(%.4f)", se_real), # Muestra el SE entre paréntesis
sprintf("(%.4f)", se_placebo)
),
# Líneas de control y efectos fijos
c("", "", ""), # Línea en blanco
