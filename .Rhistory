unique(base_voc_turismo$pdet)
# Ejecutar el PSM por región con transformaciones y método "optimal"
m_caliper_turismo <- matchit(
formula = pdet ~ log1p(poblacion) + log1p(homicidios) + log1p(t_establ_o) +
indrural + df_desemp_fisc + discapital + act_primarias +
act_secundarias + act_terciarias,
data = base_voc_turismo,
method = "nearest",     # emparejamiento por vecino más cercano
distance = "logit",     # estima el propensity score mediante regresión logística
caliper = 0.15,          # límite máximo permitido de diferencia en el propensity score
replace = FALSE
)
# Verificar el balance gráficamente
love.plot(m_caliper_turismo, threshold = 0.1, abs = TRUE)
# Extraer los datos emparejados
matched_data_turismo <- match.data(m_caliper_turismo)
# Verificar distribución después del matching
table(matched_data_turismo$pdet)
# Revisar si quedó bien el matching
resumen_psm_turismo <- summary(m_caliper_turismo, standardize = TRUE)
# Extraer balances antes y después del matching
antes_turismo <- as.data.frame(resumen_psm_turismo$sum.all)      # Balance antes del matching
despues_turismo <- as.data.frame(resumen_psm_turismo$sum.matched) # Balance después del matching
# Comparar reducción del sesgo estandarizado
comparacion_sesgo_turismo <- data.frame(
Variable = rownames(antes_turismo),
Sesgo_Antes_t = antes_turismo$`Std. Mean Diff.`,
Sesgo_Despues_t = despues_turismo$`Std. Mean Diff.`
)
# Visualizar diferencias
print(comparacion_sesgo_turismo)
# Promedio del sesgo antes y después (para verificar mejora)
mean(abs(comparacion_sesgo_turismo$Sesgo_Antes_t), na.rm = TRUE)
mean(abs(comparacion_sesgo_turismo$Sesgo_Despues_t), na.rm = TRUE)
# guardar
tabla_balance_turismo <- stargazer(
comparacion_sesgo_turismo,
summary = FALSE,
rownames = FALSE,
type = "html",
title = "Balance de Covariables Antes y Después del Matching vocación turistica",
covariate.labels = c("Variable", "Sesgo Antes", "Sesgo Después"),
digits = 3,
out = "Graficos-tablas/balance_matching_AER_turismo.html",
no.space = TRUE,
header = FALSE,
align = TRUE,
table.layout = "=ldc-t-",
font.size = "footnotesize"
)
# Para ver la tabla en la consola, puedes usar:
stargazer(comparacion_sesgo_turismo, summary = FALSE, rownames = FALSE, type = "html")
# Gráfico de PSM
grafico_sesgo_turismo <- ggplot(comparacion_sesgo_turismo,
aes(x = reorder(Variable, Sesgo_Antes_t))) +
geom_point(aes(y = Sesgo_Antes_t, color = "Antes"), size = 3, alpha = 0.8) +
geom_point(aes(y = Sesgo_Despues_t, color = "Después"), size = 3, alpha = 0.8) +
geom_hline(yintercept = c(-0.1, 0.1), linetype = "dashed", color = "gray40") +
coord_flip() +
labs(
title = "Comparación del Sesgo Estandarizado Turismo Antes y Después del Matching",
x = NULL,
y = "Sesgo Estandarizado",
color = NULL
) +
scale_color_manual(values = c("Antes" = "#B22222", "Después" = "#1E90FF")) +
theme_minimal(base_family = "serif", base_size = 13) +
theme(
plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
axis.text = element_text(color = "black"),
legend.position = "top",
legend.justification = "center",
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_line(color = "gray85")
)
# Mostrar el gráfico
grafico_sesgo_turismo
# Guardar
ggsave("Graficos-tablas/comparacion_sesgo_turismo_AER.png", grafico_sesgo_turismo,
width = 8, height = 6, dpi = 300)
#png("Graficos-tablas/hist_matching_caliper.png", width = 1200, height = 800, res = 150)
plot(m_caliper_turismo, type = "hist")
dev.off()
# Para ver las observaciones que hicieron matching
datos_emparejados_turismo <- match.data(m_caliper_turismo)
# Visualiza las primeras filas y su estructura para confirmar
head(datos_emparejados_turismo)
str(datos_emparejados_turismo)
# El número de filas será la muestra reducida y emparejada
nrow(datos_emparejados_turismo)
# Crear el año del programa
datos_emparejados_turismo <- datos_emparejados_turismo %>%
mutate(
ano = as.numeric(as.character(ano)),  # asegurar que sea numérica
event_time = ano - 2017
)
table(datos_emparejados_turismo$event_time)
# Modelo
modelo_evento_turismo <- feols(
log1p(visitantes_extranjeros_no_residentes) ~ i(event_time, pdet, ref = -1) | codmpio + ano,
cluster = ~region,
data = datos_emparejados_turismo
)
# Guadar gráfico
png("Graficos-tablas/fig_event_study_turismo_PDET.png", width = 900, height = 600, res = 150)
iplot(
modelo_evento_turismo,
ref.line = 0,
main = "Tendencias Paralelas PDET con vocación turista sobre el turismo",
xlab = "Tiempo",
ylab = "Visitantes extranjeros no residentes",
col = "black",
ci.col = "grey60",
lwd = 2,
ci.lwd = 1.2,
grid = FALSE
)
abline(v = 0, lty = 2, col = "darkred")   # línea vertical en el evento
abline(h = 0, lty = 1, col = "gray40")    # línea horizontal en cero
dev.off()
# Se escoge el año de programa
datos_emparejados_turismo <- datos_emparejados_turismo %>%
mutate(
post = as.numeric(ano >= 2017) # 1 si el año es 2017 o posterior, 0 si es anterior
)
# Modelo sin controles
modelo_did_psm_turismo <- felm(
log1p(visitantes_extranjeros_no_residentes) ~ pdet * post
| codmpio + ano
| 0
| region,
data = datos_emparejados_turismo
)
# Modelo 2 con controles
modelo_did_psm_control_turismo <- felm(
log1p(visitantes_extranjeros_no_residentes) ~ pdet * post +
log1p(poblacion) +
log1p(homicidios) +
log1p(t_establ_o) +
df_desemp_fisc +
act_terciarias
| codmpio + ano
| 0
| region,
data = datos_emparejados_turismo
)
#------------ Posible solución al problema de inestabilidad numérica--------------#
modelo_feols_corregido_turismo <- feols(
log1p(visitantes_extranjeros_no_residentes) ~ i(pdet, post, ref=0) +
log1p(poblacion) + log1p(homicidios) + log1p(t_establ_o) +
df_desemp_fisc + act_primarias + act_secundarias + act_terciarias
| codmpio + ano,
data = datos_emparejados_turismo,
cluster = ~codmpio
)
#------------------------------------------------------------------------------#
stargazer(
modelo_did_psm_turismo,
modelo_did_psm_control_turismo,
title = "Impacto del PDET con vocación turistica (DiD con PSM): Comparación de Modelos",
out = "Graficos-tablas/modelo_did_psm_comparativa.html",
type = "html",
# Ajuste de etiquetas
covariate.labels = c(
"Tratamiento (PDET)",
"Post-Tratamiento (Post 2017)",
"PDET $\\times$ Post (ATT)",
"Población (Log)",
"Homicidios (Log)",
"Establecimientos (Log)",
"Desempeño Fiscal",
"Act. Terciarias"
),
dep.var.labels = "Log(1+Visitantes Extranjeros)",
# Añadir filas para las estadísticas y los Efectos Fijos
add.lines = list(
c("Efectos Fijos de Municipio", "Sí", "Sí"),
c("Efectos Fijos de Año", "Sí", "Sí"),
c("Errores Estándar Agrupados", "Región", "Región")
),
# Etiquetas de columnas
column.labels = c("Sin Controles", "Con Controles")
)
# Fórmula del PSM
psm_formula_turismo <- pdet ~ log1p(poblacion) + log1p(homicidios) + log1p(t_establ_o) +
indrural + df_desemp_fisc + act_primarias + act_secundarias + act_terciarias
# Matching con Caliper 0.15
m_caliper_base_turismo <- matchit(
formula = psm_formula_turismo,
data = base_voc_turismo,
method = "nearest",
distance = "logit",
caliper = 0.15,
replace = FALSE
)
# Matching con Caliper 0.10
m_caliper_estricto_turismo <- matchit(
formula = psm_formula_turismo,
data = base_voc_turismo,
method = "nearest",
distance = "logit",
caliper = 0.10,
replace = FALSE
)
# Tablas de balance separadas
balance_base_turismo <- bal.tab(m_caliper_base_turismo, stats = "mean.diffs", disp.smd = TRUE)
balance_estricto_turismo <- bal.tab(m_caliper_estricto_turismo, stats = "mean.diffs", disp.smd = TRUE)
#  Mostrar los resultados
print(balance_base_turismo)
print(balance_estricto_turismo)
# Guardar resultados
# Extraer balance base
tab_base_turismo <- as.data.frame(balance_base_turismo$Balance) %>%
tibble::rownames_to_column(var = "Variable") %>%
dplyr::select(Variable, Type, Diff.Adj) %>%
rename(Diff_Adj_0.15 = Diff.Adj)
# Extraer balance estricto
tab_estricto_turismo <- as.data.frame(balance_estricto_turismo$Balance) %>%
tibble::rownames_to_column(var = "Variable") %>%
dplyr::select(Variable, Diff.Adj) %>%
rename(Diff_Adj_0.10 = Diff.Adj)
# Unir (join)
tabla_comparada_turismo <- dplyr::left_join(tab_base_turismo, tab_estricto_turismo, by = "Variable") %>%
mutate(Dif_abs = abs(Diff_Adj_0.10) - abs(Diff_Adj_0.15))
# Vector de nombres claros
nombres_claros_turismo <- c(
"distance" = "Puntaje de Propensión (Distance)",
"log1p(poblacion)" = "Log(Población)",
"log1p(homicidios)" = "Log(Homicidios)",
"log1p(t_establ_o)" = "Log(Establecimientos Totales)",
"indrural" = "Índice de Ruralidad",
"df_desemp_fisc" = "Déficit Fiscal / Desempleo",
"act_primarias" = "Actividad Primaria (%)",
"act_secundarias" = "Actividad Secundaria (%)",
"act_terciarias" = "Actividad Terciaria (%)"
)
# Limpiar y renombrar
tabla_comparada_limpia_turismo <- tabla_comparada_turismo %>%
mutate(Variable = dplyr::recode(Variable, !!!nombres_claros_turismo)) %>%
select(Variable, Type, Diff_Adj_0.15, Diff_Adj_0.10, Dif_abs) %>%
distinct()
# Generar tabla HTML
tabla_comparada_limpia_turismo %>%
kbl(
caption = "Comparación de balance entre calipers 0.15 y 0.10",
digits = 4, align = "c", booktabs = TRUE,
col.names = c("Variable", "Tipo", "Caliper 0.15", "Caliper 0.10", "Diferencia Abs")
) %>%
kable_paper("hover", full_width = FALSE) %>%
add_header_above(c(" " = 2, "Diferencias Estandarizadas de Medias" = 2, " " = 1)) %>%
save_kable("Graficos-tablas/balance_comparados_vocación turistica.html")
print("Archivo 'balance_comparado_voc_turismo_nombres.html' guardado con éxito.")
# Prueba placebo
datos_emparejados_turismo <- datos_emparejados_turismo %>%
mutate(
# Variable post real (para el modelo base)
post_real_turismo = as.numeric(ano >= 2017),
# Variable post placebo (asume que el tratamiento inició en 2015)
post_placebo_turismo = as.numeric(ano >= 2015)
)
#Se corre el modelo con el post placebo
modelo_placebo_turismo <- felm(
log1p(visitantes_extranjeros_no_residentes) ~ pdet * post_placebo_turismo +
log1p(poblacion) + log1p(homicidios) + log1p(t_establ_o) +
df_desemp_fisc + act_primarias + act_secundarias + act_terciarias
| codmpio + ano
| 0
| region,
data = datos_emparejados_turismo
)
# M1 (Base)
coef_real_turismo <- coef(modelo_did_psm_control_turismo)["pdet:post"]
se_real_turismo <- se(modelo_did_psm_control_turismo)["pdet:post"]
# M2 (Placebo)
coef_placebo_turismo <- coef(modelo_placebo_turismo)["pdet:post_placebo"]
se_placebo_turismo <- se(modelo_placebo_turismo)["pdet:post_placebo"]
# --- Generación de Tabla con Stargazer (Con corrección de \\_ ) ---
stargazer(
modelo_did_psm_control_turismo,
modelo_placebo_turismo,
title = "Prueba de Placebo vocación turistica: Falsificación del Inicio del Tratamiento",
type = "text",
# Omitir todos los coeficientes del cuerpo principal
omit = ".*",
omit.stat = c("f", "ser", "rsq"),
# Insertar el ATT real y el Placebo de forma manual sin estrellas
add.lines = list(
c("ATT (Efecto Real 2017)",
sprintf("%.4f", coef_real_turismo),
sprintf("%.4f", coef_placebo_turismo)
),
c("Error Estándar",
sprintf("(%.4f)", se_real_turismo),
sprintf("(%.4f)", se_placebo_turismo)
),
c("", "", ""),
c("Efectos Fijos de Municipio", "Sí", "Sí"),
c("Efectos Fijos de Año", "Sí", "Sí")
),
column.labels = c("Modelo Base", "Modelo Placebo"),
header = FALSE,
no.space = TRUE
)
# Modelo 2 con controles
modelo_did_psm_sinfe_turismo <- felm(
log1p(visitantes_extranjeros_no_residentes) ~ pdet + post + pdet*post +
log1p(poblacion) +
log1p(homicidios) +
log1p(t_establ_o) +
df_desemp_fisc +
act_terciarias
| 0
| 0
| region,
data = datos_emparejados_turismo
)
modelo_did_psm_mpiofe_turismo <- felm(
log1p(visitantes_extranjeros_no_residentes) ~ pdet + post + pdet*post +
log1p(poblacion) +
log1p(homicidios) +
log1p(t_establ_o) +
df_desemp_fisc +
act_terciarias
| codmpio + ano
| 0
| region,
data = datos_emparejados_turismo
)
stargazer(
modelo_did_psm_mpiofe_turismo,
modelo_did_psm_sinfe_turismo,
title = "Impacto del PDET (DiD con PSM): Comparación de Modelos municipios con vocación turística",
out = "Graficos-tablas/modelo_did_psm_comparativa_voc_turistica.html",
type = "text",
