indrural_prom = mean(indrural, na.rm = TRUE),
n_obs = n()
) %>%
ungroup()
# Verificar cuántos municipios quedan
n_distinct(datos_mpio$codmpio)
datoscede <- datoscede %>%
mutate(codmpio = as.integer(codmpio))  # O as.character(codmpio) si tiene ceros a la izquierda
datoscede <- datoscede %>%
distinct(codmpio, pdet, indrural, .keep_all = TRUE)
datos_mpio <- datoscede %>%
group_by(codmpio) %>%
summarise(
pdet = first(pdet),   # todos los pdet por municipio deberían ser iguales
indrural = mean(indrural, na.rm = TRUE),
.groups = "drop"
)
n_distinct(datos_mpio$codmpio)
datos_mpio %>% count(pdet)
# Ver cuántos municipios únicos hay en la base
n_distintos <- datoscede %>% distinct(codmpio) %>% nrow()
cat("Número de municipios distintos en la base:", n_distintos, "\n")
# ---- 2. Consolidar base a nivel municipal ----
datoscede_mpio <- datoscede %>%
filter(!is.na(codmpio)) %>%             # eliminar filas sin código municipal
group_by(codmpio) %>%
summarise(
pdet = max(pdet, na.rm = TRUE),       # si alguna observación del municipio es PDET, se marca 1
indrural = mean(indrural, na.rm = TRUE)
) %>%
mutate(pdet = ifelse(is.infinite(pdet), 0, pdet)) %>%  # manejar casos con NA
ungroup()
# ---- 3. Revisar número de municipios PDET ----
conteo <- datoscede_mpio %>% count(pdet)
print(conteo)
# ---- 4. Tabla descriptiva ----
tabla_indrural <- datoscede_mpio %>%
group_by(pdet) %>%
summarise(
Municipios = n(),
Con_dato = sum(!is.na(indrural)),
Promedio = mean(indrural, na.rm = TRUE),
Mediana = median(indrural, na.rm = TRUE),
Desviacion = sd(indrural, na.rm = TRUE),
Minimo = min(indrural, na.rm = TRUE),
Q1 = quantile(indrural, 0.25, na.rm = TRUE),
Q3 = quantile(indrural, 0.75, na.rm = TRUE),
Maximo = max(indrural, na.rm = TRUE)
) %>%
mutate(Grupo = ifelse(pdet == 1, "PDET", "No PDET")) %>%
select(Grupo, everything(), -pdet)
# Mostrar tabla directamente en consola
print(tabla_indrural)
# ---- 5. Gráfico comparativo ----
grafico_indrural <- datoscede_mpio %>%
mutate(Grupo = ifelse(pdet == 1, "PDET", "No PDET")) %>%
ggplot(aes(x = Grupo, y = indrural, fill = Grupo)) +
geom_boxplot(alpha = 0.7, width = 0.6) +
scale_fill_manual(values = c("skyblue", "seagreen3")) +
labs(
title = "Distribución del índice de ruralidad por grupo PDET",
x = "",
y = "Índice de ruralidad"
) +
theme_minimal(base_family = "Cambria") +
theme(legend.position = "none")
# ---- 6. Guardar tabla y gráfico ----
write.csv(tabla_indrural, "Graficos-tablas/tabla_indrural.csv", row.names = FALSE)
ggsave("Graficos-tablas/grafico_indrural.png", grafico_indrural, width = 7, height = 5, dpi = 300)
# Agregar al nivel municipal
