View(datoscede)
datoscede %>%
filter(!is.na(pdet), !is.na(poblacion_sisben)) %>%  # elimina NAs
group_by(pdet, poblacion_sisben) %>%
summarise(n = n(), .groups = "drop") %>%
mutate(prop = n / sum(n)) %>%
ggplot(aes(x = factor(pdet), y = prop, fill = poblacion_sisben)) +
geom_bar(stat = "identity", position = "fill") +  # apiladas proporcionales
scale_y_continuous(labels = scales::percent_format()) +
scale_fill_brewer(palette = "Set2") +
labs(
title = "Distribución de categorías del Sisbén por grupo PDET",
x = "Grupo PDET",
y = "Proporción",
fill = "Categoría Sisbén"
) +
scale_x_discrete(labels = c("0" = "No PDET", "1" = "PDET")) +
theme_minimal()
datoscede %>%
filter(!is.na(pdet), !is.na(dummy_sisben)) %>%
group_by(pdet, dummy_sisben) %>%
summarise(n = n(), .groups = "drop") %>%
mutate(prop = n / sum(n)) %>%
ggplot(aes(x = factor(pdet), y = prop, fill = factor(dummy_sisben))) +
geom_bar(stat = "identity", position = "fill") +
scale_y_continuous(labels = scales::percent_format()) +
scale_fill_manual(values = c("0" = "lightgray", "1" = "steelblue"),
labels = c("Sin Sisbén", "Con Sisbén")) +
labs(
title = "Municipios con y sin población Sisbén por grupo PDET",
x = "Grupo PDET",
y = "Proporción",
fill = "Condición Sisbén"
) +
scale_x_discrete(labels = c("0" = "No PDET", "1" = "PDET")) +
theme_minimal()
datos_plot <- datoscede %>%
filter(!is.na(pdet), !is.na(poblacion_sisben), !is.na(dummy_sisben)) %>%
group_by(pdet, poblacion_sisben, dummy_sisben) %>%
summarise(n = n(), .groups = "drop_last") %>%
mutate(prop = n / sum(n)) %>%
ungroup()
# Crear gráfico
ggplot(datos_plot, aes(x = prop, y = poblacion_sisben, fill = factor(dummy_sisben))) +
geom_bar(stat = "identity", position = "stack") +   # apiladas horizontales
facet_wrap(~pdet, labeller = as_labeller(c("0" = "No PDET", "1" = "PDET"))) +
scale_x_continuous(labels = percent_format(accuracy = 1)) +
scale_fill_manual(values = c("0" = "lightgray", "1" = "steelblue"),
labels = c("0" = "Sin Sisbén", "1" = "Con Sisbén")) +
labs(
title = "Distribución porcentual de municipios con y sin Sisbén por categoría y grupo PDET",
x = "Porcentaje de municipios",
y = "Categoría Sisbén",
fill = "Condición Sisbén"
) +
theme_minimal() +
theme(
strip.text = element_text(face = "bold", size = 11),
legend.position = "bottom"
)
summary(datoscede$poblacion_sisben)
table(datoscede$poblacion_sisben)
View(base_total)
