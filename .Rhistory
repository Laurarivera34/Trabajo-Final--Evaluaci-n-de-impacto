plot_box_pdet <- function(df, vars, titulo){
df %>%
filter(pdet == 1) %>%
select(all_of(vars)) %>%
pivot_longer(cols = everything(), names_to = "variable", values_to = "valor") %>%
mutate(variable = nombres_descriptivos_dicc[variable]) %>%
ggplot(aes(x = variable, y = valor)) +
geom_boxplot(fill = pal[20], alpha = 0.7, outlier.size = 1.5) +
scale_y_continuous(labels = comma) +
theme_bw() +
theme(panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1)) +
labs(title = titulo, x = "Variable", y = "Valor")
}
############################################################
# GRÁFICOS POR CATEGORÍA
############################################################
graf_violencia <- plot_means(base_completa,
c("tasa_homicidios","tasa_extorsion","tasa_ataq_instpol"),
"Variables de Violencia")
graf_econo <- plot_means(base_completa,
c("df_ing_propios","df_gast_inv","df_desemp_fisc","valor_agregado_pc"),
"Variables Económicas")
graf_social <- plot_means(base_completa,
c("tasa_urbanizacion","tasa_sisben"),
"Variables Sociales")
graf_turismo <- plot_means(base_completa,
c("llegadas_pasajeros_nacionales","llegadas_internacionales",
"visitantes_extranjeros_no_residentes","visitantes_pnn"),
"Variables de Turismo")
# BOXPLOTS
graf_box_violencia <- plot_box(base_completa,
c("tasa_homicidios","tasa_extorsion","tasa_ataq_instpol"),
"Distribución de Variables de Violencia")
graf_box_econo <- plot_box(base_completa,
c("df_ing_propios","df_gast_inv","df_desemp_fisc","valor_agregado_pc"),
"Distribución de Variables Económicas")
graf_box_social <- plot_box(base_completa,
c("tasa_urbanizacion","tasa_sisben"),
"Distribución de Variables Sociales")
graf_box_turismo <- plot_box(base_completa,
c("llegadas_pasajeros_nacionales","llegadas_internacionales",
"visitantes_extranjeros_no_residentes","visitantes_pnn"),
"Distribución de Variables de Turismo")
############################################################
# LISTA PARA GUARDAR GRÁFICOS
############################################################
graficos_estadisticas <- list(
graf_violencia, graf_econo, graf_social, graf_turismo,
graf_box_violencia, graf_box_econo, graf_box_social, graf_box_turismo
)
nombres_archivo <- c(
"Graficos-tablas/grafico_barras_violencia.png",
"Graficos-tablas/grafico_barras_economicas.png",
"Graficos-tablas/grafico_barras_sociales.png",
"Graficos-tablas/grafico_barras_turismo.png",
"Graficos-tablas/grafico_boxplot_violencia.png",
"Graficos-tablas/grafico_boxplot_economicas.png",
"Graficos-tablas/grafico_boxplot_sociales.png",
"Graficos-tablas/grafico_boxplot_turismo.png"
)
############################################################
# GUARDAR TODOS LOS GRÁFICOS
############################################################
for(i in seq_along(graficos_estadisticas)){
ggsave(
filename = nombres_archivo[i],
plot = graficos_estadisticas[[i]],
width = 10, height = 7, dpi = 300
)
}
############################################################
# TABLA ESTADÍSTICAS DESCRIPTIVAS (PDET vs No PDET)
############################################################
vars_graficos <- c(
"tasa_homicidios","tasa_extorsion","tasa_ataq_instpol",
"df_ing_propios","df_gast_inv","df_desemp_fisc","valor_agregado_pc",
"tasa_urbanizacion","tasa_sisben",
"llegadas_pasajeros_nacionales","llegadas_internacionales",
"visitantes_extranjeros_no_residentes","visitantes_pnn"
)
nombres_descriptivos_tabla <- nombres_descriptivos_dicc[vars_graficos]
tabla_aer <- base_completa %>%
filter(pdet %in% c(0,1)) %>%
select(pdet, all_of(vars_graficos)) %>%
pivot_longer(cols = all_of(vars_graficos), names_to = "variable", values_to = "valor") %>%
group_by(pdet, variable) %>%
summarise(
Min = min(valor, na.rm = TRUE),
Q1 = quantile(valor, 0.25, na.rm = TRUE),
Promedio = mean(valor, na.rm = TRUE),
Mediana = median(valor, na.rm = TRUE),
Q3 = quantile(valor, 0.75, na.rm = TRUE),
Max = max(valor, na.rm = TRUE),
Desviacion = sd(valor, na.rm = TRUE),
.groups = "drop"
) %>%
pivot_wider(
names_from = pdet,
values_from = c(Min, Q1, Promedio, Mediana, Q3, Max, Desviacion),
names_prefix = "pdet_"
) %>%
mutate(variable = nombres_descriptivos_tabla)
tabla_html <- tabla_aer %>%
kable(
caption = "Estadísticas descriptivas por municipio PDET y No PDET",
digits = 2, format = "html",
col.names = c(
"Variable",
"Min (No PDET)", "Q1 (No PDET)", "Promedio (No PDET)", "Mediana (No PDET)",
"Q3 (No PDET)", "Max (No PDET)", "Desv. (No PDET)",
"Min (PDET)", "Q1 (PDET)", "Promedio (PDET)", "Mediana (PDET)",
"Q3 (PDET)", "Max (PDET)", "Desv. (PDET)"
)
) %>%
kable_classic(full_width = FALSE, html_font = "Cambria")
save_kable(tabla_html, "Graficos-tablas/tabla_final_estadisticas_graficos.html")
############################################################
# PROPORCIÓN MUNICIPIOS PDET CON VOCACIÓN TURÍSTICA
############################################################
conteo_municipios <- base_completa %>%
select(codmpio, pdet, vocacion_turistica) %>%
distinct()
proporcion_pdet_turismo <- conteo_municipios %>%
summarise(
pdet_con_turismo = sum(pdet == 1 & vocacion_turistica == 1, na.rm = TRUE),
total_pdet = sum(pdet == 1, na.rm = TRUE)
) %>%
mutate(proporcion_final = (pdet_con_turismo / total_pdet) * 100)
tabla_pdet_turismo <- proporcion_pdet_turismo %>%
rename(
"Municipios PDET con vocación turística" = pdet_con_turismo,
"Total Municipios PDET" = total_pdet,
"Proporción (%)" = proporcion_final
) %>%
kable(caption = "Proporción de municipios PDET con vocación turística",
digits = 2, format = "html") %>%
kable_classic(full_width = FALSE, html_font = "Cambria")
save_kable(tabla_pdet_turismo, "Graficos-tablas/tabla_proporcion_pdet_turismo.html")
# ======================================================
# 1. CREAR AÑO DE TRATAMIENTO
# ======================================================
base_total_event <- base_completa %>%
mutate(
treat_year = if_else(pdet == 1, 2017, Inf)
)
# 1.1 Declarar panel (NECESARIO para usar l())
base_total_event <- panel(
base_total_event,
~ codmpio + ano
)
# ======================================================
# 2. ESTIMAR MODELO (asegurar nombre correcto de homicidios)
# ======================================================
modelo_sunab <- feols(
log1p(visitantes_extranjeros_no_residentes) ~
sunab(treat_year, ano) +
l(tasa_sisben, 1) +
l(tasa_homicidios, 1) |
codmpio + ano,
data = base_total_event,
cluster = ~cod_dpto
)
etable(modelo_sunab, fitstat = c("n", "r2"))
# ======================================================
# 3. GRÁFICO EVENT STUDY (con pal, sin grillas y con eje)
# ======================================================
# Paleta creada por ti
pal <- paletteer_c("grDevices::BluGrn", 30)
col_evento <- pal[1]
# Extraer años relativos del modelo para el eje
event_data <- broom::tidy(modelo_sunab) %>%
filter(grepl("sunab::", term)) %>%
mutate(
rel_year = as.numeric(gsub("sunab::", "", term))
) %>%
arrange(rel_year)
# Guardar PNG
png(
filename = "Graficos-tablas/Impacto_Visitantes_Sunab.png",
width = 2400,
height = 1600,
res = 300
)
# Parámetros del gráfico
par(bty = "l")   # limpia bordes
par(xaxs = "i", yaxs = "i")
# Gráfico principal
iplot(
modelo_sunab,
main = "Impacto PDET sobre Visitantes Extranjeros",
xlab = "Años relativos al tratamiento",
ylab = "Variación en visitantes extranjeros",
col = col_evento,
ref.line = 0,
pt.pch = 20,
grid = FALSE     # ❌ sin grillas
)
# Línea vertical en t = 0
abline(v = 0, col = "gray40", lty = 2)
# Años en el eje inferior
axis(
1,
at = event_data$rel_year,
labels = event_data$rel_year
)
dev.off()
##### MODELO 1: Diferencias en Diferencias – Municipios PDET vs No PDET
# ======================================================
# ESTANDARIZACIÓN DE LLAVES
# ======================================================
base_completa <- base_completa %>%
mutate(
codmpio  = str_pad(as.character(codmpio), 5, pad = "0"),
cod_dpto = as.character(cod_dpto)
)
# ======================================================
# CREACIÓN DE VARIABLE POST-TRATAMIENTO
# ======================================================
base_completa <- base_completa %>%
mutate(post = as.numeric(ano >= 2017))
# ======================================================
# CREACIÓN DE CONTROLES CON LAG POR MUNICIPIO
# ======================================================
base_lags <- base_completa %>%
arrange(codmpio, ano) %>%
group_by(codmpio) %>%
mutate(
l_log_pobl_tot   = lag(log_pobl_tot, 1),
l_indrural       = lag(indrural, 1),
l_tasa_urbanizacion = lag(tasa_urbanizacion, 1),
l_tasa_sisben    = lag(tasa_sisben, 1),
# Seguridad
l_tasa_homicidios = lag(tasa_homicidios, 1),
l_tasa_extorsion = lag(tasa_extorsion, 1),
l_tasa_ataq_instpol = lag(tasa_ataq_instpol, 1),
# Finanzas públicas
l_df_ing_propios = lag(df_ing_propios, 1),
l_df_gast_inv    = lag(df_gast_inv, 1),
l_df_desemp_fisc = lag(df_desemp_fisc, 1),
# Economía
l_valor_agregado_pc = lag(valor_agregado_pc, 1),
l_participacion_terciarias = lag(participacion_terciarias, 1),
# Educación
l_tasa_docentes  = lag(tasa_docentes, 1),
l_tasa_alumnos_med = lag(tasa_alumnos_med, 1),
l_s11_ingles     = lag(s11_ingles, 1),
l_s11_lectu      = lag(s11_lectu, 1),
l_log_t_establ   = lag(log_t_establ, 1)
) %>%
ungroup()
# Volvemos a definir post (por consistencia)
base_lags <- base_lags %>% mutate(post = as.numeric(ano >= 2017))
# Eliminamos NA de los lags
base_lags <- base_lags %>% filter(!is.na(l_log_pobl_tot))
# ======================================================
# MODELO 1 – DID: PDET vs No PDET (sin PSM)
# ======================================================
modelo_1_nopsm <- felm(
log1p(visitantes_extranjeros_no_residentes) ~
pdet * post +
l_log_pobl_tot +
l_indrural +
l_tasa_urbanizacion +
l_tasa_sisben +
l_tasa_homicidios +
l_tasa_extorsion +
l_tasa_ataq_instpol +
l_df_ing_propios +
l_df_gast_inv +
l_df_desemp_fisc +
l_valor_agregado_pc +
l_participacion_terciarias +
l_tasa_docentes +
l_tasa_alumnos_med +
l_s11_ingles +
l_log_t_establ +
l_s11_lectu
| codmpio + ano
| 0
| cod_dpto,
data = base_lags
)
stargazer(
modelo_1_nopsm,
title = "Modelo 1 – DiD PDET vs No PDET (sin PSM)",
type  = "text",
dep.var.labels = "log(1 + visitantes extranjeros no residentes)",
covariate.labels = c(
"PDET",
"Post 2017",
"PDET × Post",
"Lag log población total",
"Lag índice ruralidad",
"Lag tasa urbanización",
"Lag tasa SISBEN",
"Lag tasa homicidios",
"Lag tasa extorsión",
"Lag tasa ataques institucionales",
"Lag ingresos propios",
"Lag gasto inversión",
"Lag desempeño fiscal",
"Lag valor agregado per cápita",
"Lag participación sector terciario",
"Lag tasa docentes",
"Lag tasa alumnos media",
"Lag Saber 11 inglés",
"Lag log establecimientos educativos",
"Lag Saber 11 lectura"
),
keep = c(
"pdet", "post", "pdet:post",
"l_log_pobl_tot",
"l_indrural",
"l_tasa_urbanizacion",
"l_tasa_sisben",
"l_tasa_homicidios",
"l_tasa_extorsion",
"l_tasa_ataq_instpol",
"l_df_ing_propios",
"l_df_gast_inv",
"l_df_desemp_fisc",
"l_valor_agregado_pc",
"l_participacion_terciarias",
"l_tasa_docentes",
"l_tasa_alumnos_med",
"l_s11_ingles",
"l_log_t_establ",
"l_s11_lectu"
),
omit.stat = c("f", "ser", "rsq"),
no.space = TRUE
)
##### MODELO 2: DID – PDET Turístico vs No PDET
# ======================================================
# CREACIÓN DE VARIABLE tratado_tur
# ======================================================
base_lags <- base_lags %>%
mutate(
tratado_tur = if_else(pdet == 1 & vocacion_turistica == 1, 1L, 0L)
)
muestra_modelo2 <- base_lags %>%
filter(pdet == 0 | (pdet == 1 & vocacion_turistica == 1)) %>%
mutate(
tratado_tur = if_else(pdet == 1 & vocacion_turistica == 1, 1L, 0L)
)
# ======================================================
# MODELO 2 – DID: PDET Turístico vs No PDET (sin PSM)
# ======================================================
modelo_2_nopsm <- felm(
log1p(visitantes_extranjeros_no_residentes) ~
tratado_tur * post +
l_log_pobl_tot +
l_indrural +
l_tasa_urbanizacion +
l_tasa_sisben +
l_tasa_homicidios +
l_tasa_extorsion +
l_tasa_ataq_instpol +
l_df_ing_propios +
l_df_gast_inv +
l_df_desemp_fisc +
l_valor_agregado_pc +
l_participacion_terciarias +
l_tasa_docentes +
l_tasa_alumnos_med +
l_s11_ingles +
l_log_t_establ +
l_s11_lectu
| codmpio + ano
| 0
| cod_dpto,
data = muestra_modelo2
)
stargazer(
modelo_2_nopsm,
title = "Modelo 2 – DiD: PDET con vocación turística vs No PDET (sin PSM)",
type  = "text",
dep.var.labels = "log(1 + visitantes extranjeros no residentes)",
covariate.labels = c(
"Tratado turístico (PDET con vocación turística)",
"Post 2017",
"Tratado turístico × Post",
"Lag log población total",
"Lag índice ruralidad",
"Lag tasa urbanización",
"Lag tasa SISBEN",
"Lag tasa homicidios",
"Lag tasa extorsión",
"Lag tasa ataques institucionales",
"Lag ingresos propios",
"Lag gasto inversión",
"Lag desempeño fiscal",
"Lag valor agregado per cápita",
"Lag participación sector terciario",
"Lag tasa docentes",
"Lag tasa alumnos media",
"Lag Saber 11 inglés",
"Lag log establecimientos educativos",
"Lag Saber 11 lectura"
),
keep = c(
"tratado_tur", "post", "tratado_tur:post",
"l_log_pobl_tot",
"l_indrural",
"l_tasa_urbanizacion",
"l_tasa_sisben",
"l_tasa_homicidios",
"l_tasa_extorsion",
"l_tasa_ataq_instpol",
"l_df_ing_propios",
"l_df_gast_inv",
"l_df_desemp_fisc",
"l_valor_agregado_pc",
"l_participacion_terciarias",
"l_tasa_docentes",
"l_tasa_alumnos_med",
"l_s11_ingles",
"l_log_t_establ",
"l_s11_lectu"
),
omit.stat = c("f", "ser", "rsq"),
no.space = TRUE
)
##### MODELO 3: DID – PDET Turístico vs PDET No Turístico
