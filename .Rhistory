"l_log_pobl_tot", "l_log_homicidios", "l_log_extorsion",
"l_df_ing_propios", "l_df_gast_inv", "l_df_desemp_fisc",
"l_log_valor_agregado", "l_actividades_terciarias", "l_participacion_terciarias",
"l_tasa_sisben", "l_docen_total", "l_t_establ", "l_alumn_med",
