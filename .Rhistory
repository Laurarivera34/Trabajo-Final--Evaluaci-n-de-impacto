#Extracción de hojas relevantes para el análisis
leer_hoja_long <- function(hoja) {
df <- read_excel(monitor, sheet = hoja)
cols_ano <- names(df)[grepl("^[0-9]{4}$", names(df))]
df <- df %>%
select(
Divipola,
Departamento,
Municipio,
all_of(cols_ano)
)
# Pasar a formato long
df_long <- df %>%
pivot_longer(
cols = all_of(cols_ano),
names_to = "Ano",
values_to = hoja
) %>%
mutate(
Anoo = as.integer(Ano)
)
return(df_long)
}
#Unir las bases
base_long <- map_dfr(nombres_hojas, leer_hoja_long)
#Pasar a wide para tener una fila por municipio–año
base_final_monitor <- base_long %>%
distinct() %>%
pivot_wider(
id_cols = c(Divipola, Departamento, Municipio, Anio),
names_from  = NULL,
values_fill = NA
)
#Pasar a wide para tener una fila por municipio–año
base_final_monitor <- base_long %>%
distinct() %>%
pivot_wider(
id_cols = c(Divipola, Departamento, Municipio, Ano),
names_from  = NULL,
values_fill = NA
)
View(base_long)
rm(leer_hoja_long())
rm(leer_hoja_long(monitor))
#Extracción de hojas relevantes para el análisis
leer_hoja_long <- function(hoja) {
df <- read_excel(monitor, sheet = hoja)
cols_ano <- names(df)[grepl("^[0-9]{4}$", names(df))]
df <- df %>%
select(
Divipola,
Departamento,
Municipio,
all_of(cols_ano)
)
# Pasar a formato long
df_long <- df %>%
pivot_longer(
cols = all_of(cols_ano),
names_to = "Ano",
values_to = "Valor"
) %>%
mutate(
Ano = as.integer(Ano),
Variable_Fuente = hoja
)
return(df_long)
}
