leer_hoja_long <- function(hoja) {
df <- read_excel(archivo_excel, sheet = hoja)
df_long <- df %>%
pivot_longer(
cols = -c(Departamento, Municipio, Divipola),  # claves
names_to = "ano",
values_to = "valor"
) %>%
mutate(
ano = as.integer(ano),
Variable = hoja
)
return(df_long)
}
leer_hoja_long <- function(hoja) {
df <- read_excel(monitor, sheet = hoja)
df_long <- df %>%
pivot_longer(
cols = -c(Departamento, Municipio, Divipola),  # claves
names_to = "ano",
values_to = "valor"
) %>%
mutate(
ano = as.numeric(ano),
variable = hoja
)
return(df_long)
}
