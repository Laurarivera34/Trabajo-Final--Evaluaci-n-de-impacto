select(-any_of(vars_a_eliminar))
# calcular top 10 municipios por grupo PDET / No PDET
top_homicidios <- datoscede %>%
group_by(pdet, mpio) %>%
summarise(total_homicidios = sum(homicidios, na.rm = TRUE), .groups = "drop") %>%
arrange(pdet, desc(total_homicidios)) %>%
group_by(pdet) %>%
slice_head(n = 10) %>%   # top 10 por grupo
ungroup()
# calcular top 10 municipios por grupo PDET / No PDET
top_homicidios <- datoscede %>%
group_by(pdet, codmpio) %>%
summarise(total_homicidios = sum(homicidios, na.rm = TRUE), .groups = "drop") %>%
arrange(pdet, desc(total_homicidios)) %>%
group_by(pdet) %>%
slice_head(n = 10) %>%   # top 10 por grupo
ungroup()
# gráfico de barras horizontales
ggplot(top_homicidios, aes(x = reorder(codmpio, total_homicidios),
y = total_homicidios,
fill = factor(pdet))) +
geom_bar(stat = "identity") +
coord_flip() +
facet_wrap(~pdet, scales = "free_y", labeller = labeller(pdet = c("0" = "No PDET", "1" = "PDET"))) +
scale_fill_manual(values = c("0" = "lightblue", "1" = "salmon"),
labels = c("No PDET", "PDET")) +
labs(title = "Top 10 municipios con más homicidios",
x = "Municipio",
y = "Total de homicidios",
fill = "Grupo PDET") +
theme_minimal() +
theme(axis.text.y = element_text(size = 10),
plot.title = element_text(face = "bold", hjust = 0.5))
