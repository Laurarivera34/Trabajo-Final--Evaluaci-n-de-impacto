modelo_feols <- feols(
log1p(visitantes_extranjeros_no_residentes) ~ pdet * post +
log1p(poblacion) + log1p(homicidios) + log1p(t_establ_o) +
df_desemp_fisc + act_terciarias
| codmpio + ano, # Efectos Fijos
