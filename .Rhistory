)
print(summary(match_out_m3))
bal_m3 <- bal.tab(match_out_m3, un = TRUE)
print(bal_m3)
love.plot(bal_m3, threshold = .1, main = "Love plot: M3 (PDET tur vs PDET no tur)")
datos_matched_m3 <- match.data(match_out_m3) %>%
dplyr::select(codmpio, weights) %>%
distinct(codmpio, .keep_all = TRUE)
base_panel_psm_m3 <- base_lags %>%
filter(codmpio %in% datos_matched_m3$codmpio) %>%
left_join(datos_matched_m3, by = "codmpio")
stopifnot(sum(is.na(base_panel_psm_m3$weights)) == 0)
modelo_3_psm <- felm(
log1p(visitantes_extranjeros_no_residentes) ~
pdet_tur_dummy * post +
l_log_pobl_tot + l_indrural + l_tasa_urbanizacion + l_tasa_sisben +
l_tasa_homicidios + l_tasa_extorsion + l_tasa_ataq_instpol +
l_df_ing_propios + l_df_gast_inv + l_df_desemp_fisc +
l_valor_agregado_pc + l_participacion_terciarias +
l_tasa_docentes + l_tasa_alumnos_med + l_s11_ingles + l_log_t_establ + l_s11_lectu
| codmpio + ano | 0 | cod_dpto,
data = base_panel_psm_m3,
weights = base_panel_psm_m3$weights
)
# ==============================================================================
# 4. RESULTADOS FINALES EN STARGAZER
# ==============================================================================
stargazer(
modelo_1_nopsm, modelo_1_psm,
modelo_2_nopsm, modelo_2_psm,
modelo_3_nopsm, modelo_3_psm,
title = "Resultados DiD: Comparación Sin PSM vs Con PSM",
type  = "text",
dep.var.labels = "log(1 + Visitantes Extranjeros)",
model.numbers = FALSE,
column.labels = c("M1 (DiD)", "M1 (DiD+PSM)",
"M2 (DiD)", "M2 (DiD+PSM)",
"M3 (DiD)", "M3 (DiD+PSM)"),
covariate.labels = c(
"PDET (Tratamiento)",
"Tratado Turístico (M2)",
"PDET Turístico (M3)",
"Post 2017",
"PDET × Post (Efecto DiD M1)",
"Tratado Turístico × Post (Efecto DiD M2)",
"PDET Turístico × Post (Efecto DiD M3)",
"Lag log población total",
"Lag índice ruralidad",
"Lag tasa urbanización",
"Lag tasa SISBEN",
"Lag tasa homicidios",
"Lag tasa extorsión",
"Lag tasa ataques inst.",
"Lag ingresos propios",
"Lag gasto inversión",
"Lag desempeño fiscal",
"Lag valor agregado pc",
"Lag participación terc.",
"Lag tasa docentes",
"Lag tasa alumnos media",
"Lag Saber 11 inglés",
"Lag log establecimientos",
"Lag Saber 11 lectura"
),
keep = c(
"pdet", "tratado_tur", "pdet_tur_dummy",
"post",
"pdet:post", "tratado_tur:post", "pdet_tur_dummy:post",
"l_log_pobl_tot", "l_indrural", "l_tasa_urbanizacion", "l_tasa_sisben",
"l_tasa_homicidios", "l_tasa_extorsion", "l_tasa_ataq_instpol",
"l_df_ing_propios", "l_df_gast_inv", "l_df_desemp_fisc",
"l_valor_agregado_pc", "l_participacion_terciarias",
"l_tasa_docentes", "l_tasa_alumnos_med", "l_s11_ingles", "l_log_t_establ",
"l_s11_lectu"
),
omit.stat = c("f", "ser", "rsq"),
add.lines = list(
c("Efectos Fijos", rep("Mpio, Año", 6)),
c("Metodología", rep(c("DiD", "DiD + PSM"), 3))
),
no.space = TRUE
)
#####//////////////Prueba Laura
library(dplyr)
library(MatchIt)
library(fixest)
# -------------------------------------------------------
# 1. CREAR LA VARIABLE DE TRATAMIENTO PARA EL PSM
# -------------------------------------------------------
base_lags <- base_lags %>%
mutate(
tratado_tur = if_else(pdet == 1 & vocacion_turistica == 1, 1L, 0L)
)
base_pre <- base_lags %>%
filter(ano < 2017)
# Covariables del PSM
vars_psm <- c(
"l_log_pobl_tot",
"l_indrural",
"l_tasa_urbanizacion",
"l_tasa_sisben",
"l_tasa_homicidios",
"l_df_ing_propios",
"l_df_desemp_fisc",
"l_valor_agregado_pc",
"l_participacion_terciarias"
)
# Filtrar pretratamiento
base_pre <- base_lags %>%
filter(ano < 2017)
# 1. Verificar NA en covariables del PSM
sapply(base_pre[vars_psm], function(x) sum(is.na(x)))
# 2. Eliminar SOLO filas con NA en covariables del PSM
base_pre_clean <- base_pre %>%
filter(across(all_of(vars_psm), ~ !is.na(.)))
# 3. Fórmula del PSM
f_psm <- as.formula(
paste("tratado_tur ~", paste(vars_psm, collapse = " + "))
)
# 4. PSM (ya sin NA)
modelo_psm <- matchit(
f_psm,
data = base_pre_clean,
method = "nearest",
ratio = 1,
replace = TRUE
)
datos_emparejados <- match.data(modelo_psm)
# -------------------------------------------------------
# 3. CREAR EVENT_TIME Y BASE MATCHED COMPLETA
# -------------------------------------------------------
base_matched_full <- base_lags %>%
filter(codmpio %in% datos_emparejados$codmpio)
base_matched_full <- base_matched_full %>%
mutate(
event_time = ano - 2017,
post = as.numeric(ano >= 2017)
)
# -------------------------------------------------------
# 4. TENDENCIAS PARALELAS (solo pre)
# -------------------------------------------------------
base_pre_event <- base_matched_full %>%
filter(event_time < 0)
modelo_pretrend <- feols(
log1p(visitantes_extranjeros_no_residentes) ~
i(event_time, tratado_tur, ref = -1) |
codmpio + ano,
cluster = "cod_dpto",
data = base_pre_event
)
iplot(modelo_pretrend)
# -------------------------------------------------------
# 5. EVENT STUDY COMPLETO
# -------------------------------------------------------
modelo_event_final <- feols(
log1p(visitantes_extranjeros_no_residentes) ~
i(event_time, tratado_tur, ref = -1) +
l_log_pobl_tot +
l_indrural +
l_tasa_urbanizacion +
l_tasa_sisben +
l_tasa_homicidios +
l_df_ing_propios +
l_df_desemp_fisc +
l_valor_agregado_pc +
l_participacion_terciarias
| codmpio + ano,
cluster = "cod_dpto",
data = base_matched_full
)
iplot(modelo_event_final)
# -------------------------------------------------------
# 6. DID CLÁSICO (SIN CONTROLES)
# -------------------------------------------------------
modelo_did_simple <- feols(
log1p(visitantes_extranjeros_no_residentes) ~
tratado_tur * post |
codmpio + ano,
cluster = "cod_dpto",
data = base_matched_full
)
summary(modelo_did_simple)
# -------------------------------------------------------
# 7. DID CON CONTROLES (TU ESPECIFICACIÓN)
# -------------------------------------------------------
modelo_did_controles <- feols(
log1p(visitantes_extranjeros_no_residentes) ~
tratado_tur * post +
l_log_pobl_tot +
l_indrural +
l_tasa_urbanizacion +
l_tasa_sisben +
l_tasa_homicidios +
l_df_ing_propios +
l_df_desemp_fisc +
l_valor_agregado_pc +
l_participacion_terciarias
| codmpio + ano,
cluster = "cod_dpto",
data = base_matched_full
)
summary(modelo_did_controles)
