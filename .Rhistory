)
stargazer(
modelo_2_psm,
title = "Modelo 2 – PDET turístico vs No PDET (con PSM)",
type = "text",
dep.var.labels = "tasa de empresas turísticas",
covariate.labels = c(
"Lag log población total",
"Lag tasa urbanización",
"Lag tasa SISBEN",
"Lag participación sector terciario",
"Tratado_tur × Post"
),
keep = c(
"l_log_pobl_tot",
"l_tasa_urbanizacion",
"l_tasa_sisben",
"l_participacion_terciarias",
"tratado_tur:post"
),
omit.stat = c("f", "ser", "rsq"),
no.space = TRUE
)
# ======================================================
# PSM PARA MODELO 3
# ======================================================
muestra3_pre <- base_lags_alterna %>%
filter(pdet == 1, ano == 2016) %>%
mutate(tur = vocacion_turistica)
psm_mod3 <- matchit(
tur ~ log_pobl_tot + tasa_urbanizacion + tasa_sisben + participacion_terciarias,
data = muestra3_pre,
method = "nearest",
ratio = 1
)
matched_ids3 <- match.data(psm_mod3) %>% pull(codmpio)
muestra_modelo3_psm <- base_lags_alterna %>%
filter(codmpio %in% matched_ids3)
# ======================================================
# DID CON BASE EMPAREJADA – MODELO 3
# ======================================================
modelo_3_psm <- felm(
tasanumagencia_alterna ~
tratado_tur:post +
l_log_pobl_tot +
l_tasa_urbanizacion +
l_tasa_sisben +
l_participacion_terciarias
| codmpio + ano
| 0
| cod_dpto,
data = muestra_modelo3_psm
)
stargazer(
modelo_3_psm,
title = "Modelo 3 – PDET turístico vs PDET no turístico (con PSM)",
type = "text",
dep.var.labels = "tasa de empresas turísticas",
covariate.labels = c(
"Lag log población total",
"Lag tasa urbanización",
"Lag tasa SISBEN",
"Lag participación sector terciario",
"Tratado_tur × Post"
),
keep = c(
"l_log_pobl_tot",
"l_tasa_urbanizacion",
"l_tasa_sisben",
"l_participacion_terciarias",
"tratado_tur:post"
),
omit.stat = c("f", "ser", "rsq"),
no.space = TRUE
)
# ======================================================
# PSM PREVIO AL EVENT STUDY
# ======================================================
# Usamos el año pretratamiento (2016)
psm_event <- matchit(
pdet ~ log_pobl_tot + tasa_urbanizacion + tasa_sisben + participacion_terciarias,
data = base_alterna %>% filter(ano == 2016),
method = "nearest",
ratio = 1
)
# Obtener municipios emparejados
matched_ids_event <- match.data(psm_event) %>% pull(codmpio)
# Filtramos todo el panel para esos municipios
base_alterna_matched <- base_alterna %>%
filter(codmpio %in% matched_ids_event)
# ======================================================
# CREAR AÑO DE TRATAMIENTO (USANDO BASE EMPAREJAD
# ======================================================
base_alterna_event <- base_alterna_matched %>%
mutate(
treat_year = if_else(pdet == 1, 2017, Inf)
)
# Declarar panel
base_alterna_event <- panel(base_alterna_event, ~ codmpio + ano)
# ======================================================
# CREAR AÑO DE TRATAMIENTO
# ======================================================
base_alterna_event <- base_alterna_matched %>%
mutate(
treat_year = if_else(pdet == 1, 2017, Inf)
)
# Declarar panel
base_alterna_event <- panel(base_alterna_event, ~ codmpio + ano)
# ======================================================
# ESTIMAR MODELO EVENT STUDY CON PSM
# ======================================================
modelo_alterno_psm <- feols(
tasa_empr_tur_alterna ~
sunab(treat_year, ano) +
l(log_pobl_tot, 1) +
l(tasa_urbanizacion, 1) +
l(participacion_terciarias, 1) +
l(tasa_sisben, 1)   |
codmpio + ano,
data = base_alterna_event,
cluster = ~ cod_dpto
)
etable(modelo_alterno_psm, fitstat = c("n", "r2"))
# ======================================================
# GRÁFICO EVENT STUDY (con PSM)
# ======================================================
# Paleta
pal <- paletteer_c("grDevices::BluGrn", 30)
col_evento <- pal[1]
# Gráfico en pantalla
iplot(
modelo_alterno_psm,
xlab = "Años relativos al tratamiento (Año base: 2017)",
ylab = "Variación en Tasa de empresas turísticas",
main = "Test de Tendencias Paralelas (PDET vs No PDET) - Con PSM",
col = col_evento,
ref.line = 0,
pt.pch = 20,
ci.lty = 2,
grid = TRUE
)
# Guardar el gráfico
p <- recordPlot()
png("Graficos-tablas/modelo_alterno_psm_iplot.png",
width = 2400, height = 1600, res = 300)
replayPlot(p)
dev.off()
############################################################
# 1. TABULACIÓN DE MODELOS SIN PSM
############################################################
# ---------------------------------------------
# Listado de modelos DiD sin PSM
# ---------------------------------------------
modelos_sin_psm <- list(
"M1 (DiD)" = modelo_1_nopsm,
"M2 (DiD)" = modelo_2_nopsm,
"M3 (DiD)" = modelo_3_nopsm
)
# ---------------------------------------------
# Tabla en formato LaTeX
# ---------------------------------------------
tabla_modelos_sinpsm <- stargazer(
modelos_sin_psm,
title = "Tabla 1: Resultados DiD sin PSM (Efectos Fijos)",
type = "latex",
dep.var.labels = "Tasa de empresas turísticas",
model.numbers = FALSE,
column.labels = c("Modelo 1", "Modelo 2", "Modelo 3"),
# ---------------------------
# Etiquetas de coeficientes
# ---------------------------
covariate.labels = c(
# Interacciones (efecto DiD)
"PDET × Post (M1)",
"Turístico × Post (M2, M3)",
# Variables base (nivel)
"PDET (M1)",
"Tratado Turístico (M2, M3)",
"Post",
# Controles lagged
"Lag log población total",
"Lag tasa urbanización",
"Lag tasa SISBEN",
"Lag participación terciarias"
),
# ---------------------------
# Variables incluidas
# ---------------------------
keep = c(
"pdet:post", "tratado_tur:post",
"pdet", "tratado_tur", "post",
"l_log_pobl_tot",
"l_tasa_urbanizacion",
"l_tasa_sisben",
"l_participacion_terciarias"
),
# ---------------------------
# Estadísticas adicionales
# ---------------------------
omit.stat = c("f", "ser", "rsq"),
add.lines = list(
c("Efectos Fijos (Mpio & Año)", rep("Sí", 3)),
c("Errores Estándar", rep("Clusterizados (Dpto)", 3))
),
no.space = TRUE
)
# Guardar archivo .tex
cat(tabla_modelos_sinpsm,
file = "Graficos-tablas/tabla_modelos_sinpsm.tex")
