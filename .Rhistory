"M2 (DiD + PSM) Entre turísticos (PDET vs No PDET)" = modelo_2_psm,
"M3 (DiD + PSM) PDET vs No PDET (general)" = modelo_3_psm
),
estimate  = "{estimate}{stars}",
statistic = "({std.error})",
coef_map  = coef_map,
vcov      = function(x) x$clustervcv,
title     = "Resultados DiD con PSM: Comparación de Modelos",
output    = "latex_tabular"
)
# ======================================================
# 1. CREAR AÑO DE TRATAMIENTO
# ======================================================
base_alterna_event <- base_alterna %>%
mutate(
treat_year = if_else(pdet == 1, 2017, Inf)
)
# Panel
base_alterna_event <- panel(base_alterna_event, ~ codmpio + ano)
# ======================================================
# 2. ESTIMAR MODELO
# ======================================================
modelo_alterno <- feols(
(tasa_empr_tur_alterna) ~
sunab(treat_year, ano) +
l(log_pobl_tot, 1) +
l(tasa_urbanizacion, 1) +
l(participacion_terciarias, 1) +
l(tasa_sisben, 1)   |
codmpio + ano,
data = base_alterna_event,
cluster = ~ cod_dpto
)
etable(modelo_alterno, fitstat = c("n", "r2"))
# ======================================================
# 3. GRÁFICO EVENT STUDY
# ======================================================
# Paleta
pal <- paletteer_c("grDevices::BluGrn", 30)
col_evento <- pal[1]
# Gráfico en pantalla
iplot(
modelo_alterno,
xlab = "Años relativos al tratamiento (Año base: 2017)",
ylab = "Variación en Tasa de empresas turísticas",
main = "Test de Tendencias Paralelas (PDET vs No PDET)",
col = col_evento,
ref.line = 0,
pt.pch = 20,
ci.lty = 2,
grid = TRUE
)
# --- Guardar el mismo gráfico, SIN repetir iplot ---
p <- recordPlot()  # captura lo que ya se dibujó en pantalla
png("Graficos-tablas/modelo_alterno_iplot.png", width = 2400, height = 1600, res = 300)
replayPlot(p)      # reproduce el gráfico capturado
dev.off()
base_alterna <- base_alterna %>%
mutate(
tasanumagencia_alterna    = (numagencia_alterna / pobl_tot) * 100000)
##### MODELO 1: Diferencias en Diferencias – Municipios PDET vs No PDET
# ======================================================
# ESTANDARIZACIÓN DE LLAVES
# ======================================================
base_alterna <- base_alterna %>%
mutate(
codmpio  = str_pad(as.character(codmpio), 5, pad = "0"),
cod_dpto = as.character(cod_dpto)
)
# ======================================================
# CREACIÓN DE CONTROLES CON LAG POR MUNICIPIO
# ======================================================
base_lags_alterna <- base_alterna %>%
arrange(codmpio, ano) %>%
group_by(codmpio) %>%
mutate(
tasanumagencia_alterna,
l_log_pobl_tot   = lag(log_pobl_tot, 1),
l_tasa_urbanizacion = lag(tasa_urbanizacion, 1),
l_tasa_sisben    = lag(tasa_sisben, 1),
# Economía
l_participacion_terciarias = lag(participacion_terciarias, 1),
) %>%
ungroup()
# Volvemos a definir post (por consistencia)
base_lags_alterna <- base_lags_alterna %>% mutate(post = as.numeric(ano >= 2017))
# Eliminamos NA de los lags
base_lags_alterna <- base_lags_alterna %>% filter(!is.na(l_log_pobl_tot))
##### MODELO 1: DID – PDET Turístico vs PDET No Turístico
# ======================================================
# CREACIÓN DE MUESTRA PARA MODELO 1
# ======================================================
muestra_modelo1a <- base_lags_alterna %>%
filter(pdet == 1) %>%
mutate(
tratado_tur = if_else(vocacion_turistica == 1, 1L, 0L)
)
# ======================================================
# MODELO 1 – DID: entre municipios PDET (sin PSM)
# ======================================================
modelo_1a_nopsm <- felm(
tasanumagencia_alterna ~
tratado_tur:post  +
l_log_pobl_tot +
l_tasa_urbanizacion +
l_tasa_sisben +
l_participacion_terciarias
| codmpio + ano
| 0
| cod_dpto,
data = muestra_modelo1a
)
stargazer(
modelo_1a_nopsm,
title = "Modelo 1 – DiD: PDET con vocación turística vs PDET sin vocación turística (sin PSM)",
type  = "text",
dep.var.labels = "tasa de empresas turísticas",
covariate.labels = c(
"Lag log población total",
"Lag tasa urbanización",
"Lag tasa SISBEN",
"Lag participación sector terciario",
"Tratado_tur × Post"
),
keep = c(
"l_log_pobl_tot",
"l_tasa_urbanizacion",
"l_tasa_sisben",
"l_participacion_terciarias",
"tratado_tur:post"
)
,
omit.stat = c("f", "ser", "rsq"),
no.space = TRUE
)
##### MODELO 2: DID – PDET Turístico vs No PDET
# ======================================================
# CREACIÓN DE VARIABLE tratado_tur
# ======================================================
base_lags_alterna <- base_lags_alterna %>%
mutate(
tratado_tur = if_else(pdet == 1 & vocacion_turistica == 1, 1L, 0L)
)
muestra_modelo2a <- base_lags_alterna %>%
filter(pdet == 0 | (pdet == 1 & vocacion_turistica == 1)) %>%
mutate(
tratado_tur = if_else(pdet == 1 & vocacion_turistica == 1, 1L, 0L)
)
# ======================================================
# MODELO 2 – DID: PDET Turístico vs No PDET (sin PSM)
# ======================================================
modelo_2a_nopsm <- felm(
tasanumagencia_alterna ~
tratado_tur:post  +
l_log_pobl_tot +
l_tasa_urbanizacion +
l_tasa_sisben +
l_participacion_terciarias
| codmpio + ano
| 0
| cod_dpto,
data = muestra_modelo2a
)
stargazer(
modelo_2a_nopsm,
title = "Modelo 2 – DiD: PDET con vocación turística vs No PDET (sin PSM)",
type  = "text",
dep.var.labels = "tasa de empresas turísticas",
covariate.labels = c(
"Lag log población total",
"Lag tasa urbanización",
"Lag tasa SISBEN",
"Lag participación sector terciario",
"Tratado_tur × Post"
),
keep = c(
"l_log_pobl_tot",
"l_tasa_urbanizacion",
"l_tasa_sisben",
"l_participacion_terciarias",
"tratado_tur:post"
)
,
omit.stat = c("f", "ser", "rsq"),
no.space = TRUE
)
# ======================================================
# MODELO 3 – DID: PDET vs No PDET (sin PSM)
# ======================================================
modelo_3a_nopsm <- felm(
tasanumagencia_alterna ~
pdet:post +
l_log_pobl_tot +
l_tasa_urbanizacion +
l_tasa_sisben +
l_participacion_terciarias
| codmpio + ano
| 0
| cod_dpto,
data = base_lags_alterna
)
stargazer(
modelo_3a_nopsm,
title = "Modelo 3 – DiD PDET vs No PDET (sin PSM)",
type  = "text",
dep.var.labels = "tasa de empresas turísticas",
covariate.labels = c(
"Lag log población total",
"Lag tasa urbanización",
"Lag tasa SISBEN",
"Lag participación sector terciario",
"PDET × Post"
),
keep = c(
"l_log_pobl_tot",
"l_tasa_urbanizacion",
"l_tasa_sisben",
"l_participacion_terciarias",
"pdet:post"
),
omit.stat = c("f", "ser", "rsq"),
no.space = TRUE
)
# ==============================================================================
# RESULTADOS EN LATEX – COMPARACIÓN DE MODELOS (SIN PSM)
# ==============================================================================
coef_map_alt <- c(
# Interacciones DiD
"tratado_tur:post"             = "Tratado turístico × Post (M1 y M2)",
"pdet:post"                    = "PDET × Post (M3)",
# Controles
"l_log_pobl_tot"               = "Lag log población total",
"l_tasa_urbanizacion"          = "Lag tasa urbanización",
"l_tasa_sisben"                = "Lag tasa SISBEN",
"l_participacion_terciarias"   = "Lag participación terciarias"
)
modelsummary(
list(
"M1: PDET turísticos vs PDET no turísticos" = modelo_1a_nopsm,
"M2: PDET turísticos vs No PDET"            = modelo_2a_nopsm,
"M3: PDET vs No PDET (general)"             = modelo_3a_nopsm
),
estimate  = "{estimate}{stars}",
statistic = "({std.error})",
coef_map  = coef_map_alt,
vcov      = function(x) x$clustervcv,
title     = "Resultados DiD – Tasa de empresas turísticas (sin PSM)",
output    = "latex_tabular"
)
# ======================================================
# PSM PREVIO AL EVENT STUDY
# ======================================================
# Usamos el año pretratamiento (2016)
psm_event <- matchit(
pdet ~ log_pobl_tot + tasa_urbanizacion + tasa_sisben + participacion_terciarias,
data = base_alterna %>% filter(ano == 2016),
method = "nearest",
ratio = 1
)
# Obtener municipios emparejados
matched_ids_event <- match.data(psm_event) %>% pull(codmpio)
# Filtramos todo el panel para esos municipios
base_alterna_matched <- base_alterna %>%
filter(codmpio %in% matched_ids_event)
# ======================================================
# CREAR AÑO DE TRATAMIENTO (USANDO BASE EMPAREJAD
# ======================================================
base_alterna_event <- base_alterna_matched %>%
mutate(
treat_year = if_else(pdet == 1, 2017, Inf)
)
# Declarar panel
base_alterna_event <- panel(base_alterna_event, ~ codmpio + ano)
# ======================================================
# CREAR AÑO DE TRATAMIENTO
# ======================================================
base_alterna_event <- base_alterna_matched %>%
mutate(
treat_year = if_else(pdet == 1, 2017, Inf)
)
# Declarar panel
base_alterna_event <- panel(base_alterna_event, ~ codmpio + ano)
# ======================================================
# ESTIMAR MODELO EVENT STUDY CON PSM
# ======================================================
modelo_alterno_psm <- feols(
tasa_empr_tur_alterna ~
sunab(treat_year, ano) +
l(log_pobl_tot, 1) +
l(tasa_urbanizacion, 1) +
l(participacion_terciarias, 1) +
l(tasa_sisben, 1)   |
codmpio + ano,
data = base_alterna_event,
cluster = ~ cod_dpto
)
etable(modelo_alterno_psm, fitstat = c("n", "r2"))
# ======================================================
# GRÁFICO EVENT STUDY (con PSM)
# ======================================================
# Paleta
pal <- paletteer_c("grDevices::BluGrn", 30)
col_evento <- pal[1]
# Gráfico en pantalla
iplot(
modelo_alterno_psm,
xlab = "Años relativos al tratamiento (Año base: 2017)",
ylab = "Variación en Tasa de empresas turísticas",
