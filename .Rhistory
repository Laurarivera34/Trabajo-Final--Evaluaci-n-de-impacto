# Tabla de estadísticas descriptivas de homicidios por grupo PDET
tabla_homicidios <- datoscede %>%
filter(!is.na(pdet), !is.na(homicidios)) %>%
group_by(pdet) %>%
summarise(
N_municipios = n(),
Min = min(homicidios, na.rm = TRUE),
Q1 = quantile(homicidios, 0.25, na.rm = TRUE),
Promedio = mean(homicidios, na.rm = TRUE),
Mediana = median(homicidios, na.rm = TRUE),
Q3 = quantile(homicidios, 0.75, na.rm = TRUE),
Max = max(homicidios, na.rm = TRUE),
Desviación = sd(homicidios, na.rm = TRUE)
) %>%
mutate(Grupo = ifelse(pdet == 1, "PDET", "No PDET")) %>%
select(Grupo, everything(), -pdet)
# Mostrar tabla en HTML bonito
tabla_homicidios %>%
kable(
caption = "Estadísticas descriptivas de homicidios por grupo PDET",
digits = 2,
col.names = c("Grupo", "N", "Mínimo", "1er Cuartil", "Promedio", "Mediana", "3er Cuartil", "Máximo", "Desviación estándar")
) %>%
kable_classic(full_width = FALSE, html_font = "Cambria")
