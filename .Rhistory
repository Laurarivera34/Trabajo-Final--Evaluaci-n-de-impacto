#Resultados
resultados_simple <- summary(modelo_event_study_1)$coeftable %>%
as.data.frame() %>%
tibble::rownames_to_column("term") %>%
filter(str_detect(term, "pdet")) %>%
mutate(
tiempo_rel = as.numeric(str_extract(term, "pdet::[0-9-]+$") %>% str_replace("pdet::", "")),
IC_bajo = Estimate - 1.96 * `Std. Error`,
IC_alto = Estimate + 1.96 * `Std. Error`
) %>%
bind_rows(tibble(tiempo_rel = -1, Estimate = 0, `Std. Error` = 0, IC_bajo = 0, IC_alto = 0)) %>%
arrange(tiempo_rel)
modelo_event_study_1 <- feols(
vocacion_turistica ~ i(tiempo_rel, pdet, ref = -1) + l(tasa_sisben, 1) +
l(tasa_homicidios, 1) | codmpio + ano,
data = base_total_event,
panel.id = ~codmpio + ano,
cluster = ~cod_dpto
)
#Resultados
resultados_simple <- summary(modelo_event_study_1)$coeftable %>%
as.data.frame() %>%
tibble::rownames_to_column("term") %>%
filter(str_detect(term, "pdet")) %>%
mutate(
tiempo_rel = as.numeric(str_extract(term, "pdet::[0-9-]+$") %>% str_replace("pdet::", "")),
IC_bajo = Estimate - 1.96 * `Std. Error`,
IC_alto = Estimate + 1.96 * `Std. Error`
) %>%
bind_rows(tibble(tiempo_rel = -1, Estimate = 0, `Std. Error` = 0, IC_bajo = 0, IC_alto = 0)) %>%
arrange(tiempo_rel)
# Generación del Gráfico Simple
grafico_event_simple <- ggplot(resultados_simple, aes(x = tiempo_rel, y = Estimate)) +
geom_point(size = 3, color = "#0072B2") +
geom_errorbar(aes(ymin = IC_bajo, ymax = IC_alto), width = 0.2, color = "#0072B2") +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
geom_vline(xintercept = -0.5, linetype = "dotted", color = "red", size = 1) +
labs(
title = "Event Study: Tendencias Paralelas (Controles Simples)",
x = "Años Relativos al Tratamiento (t=0 es el año 2017)",
y = "Diferencia Estimada en Vocación Turística"
) +
theme_minimal() +
scale_x_continuous(breaks = sort(unique(resultados_simple$tiempo_rel)))
print(grafico_event_simple)
etable(modelo_event_study)
