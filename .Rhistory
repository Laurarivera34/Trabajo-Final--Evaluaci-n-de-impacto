log1p(visitantes_extranjeros_no_residentes) ~ i(event_time, pdet, ref = -1) | codmpio + ano,
cluster = ~region,
data = datos_emparejados
)
modelo_evento
iplot(modelo_evento, ref.line = 0, main = "Efectos dinámicos del PDET sobre el turismo internacional")
